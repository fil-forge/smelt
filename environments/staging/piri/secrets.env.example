# Piri bundle — secret environment values (REDACTED EXAMPLE, structure only).
#
# The real file is rendered from secrets.env.tpl via `op inject` and lives only on
# the box as $FORGE_SECRETS_DIR/piri-secrets.env. This example shows the shape
# reviewers should expect — no real values.

POSTGRES_ADMIN_PASSWORD=<rendered from 1Password>
PIRI_0_POSTGRES_PASSWORD=<rendered from 1Password>
INGOT_POSTGRES_PASSWORD=<rendered from 1Password>
