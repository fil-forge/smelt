# Piri bundle — pinned image version (THE atomic deploy unit for this bundle).
#
# Pin to an immutable @sha256:... digest before a real deploy; the rolling :main
# tag below is a placeholder so `docker compose config` parses.
#   docker buildx imagetools inspect ghcr.io/fil-forge/piri:main
#
# Pre-merge test: rolling per-PR tag. Re-push this tag to iterate, then
# `make staging-deploy-piri` (its `docker compose pull` picks up the new image)
# without editing this file. Revert to a :main sha- digest once the PR lands.
PIRI_IMAGE=ghcr.io/fil-forge/piri:bajtos-pr-24
