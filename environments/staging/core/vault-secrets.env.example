# Core bundle — hilt VAULT secret values (REDACTED EXAMPLE, structure only).
#
# The real file is minted by `vault operator init` and rendered from
# vault-secrets.env.tpl by `make staging-vault-init`; it lives only on the box.
# This example shows the shape reviewers should expect — no real values.

HILT_VAULT_TOKEN=<vault root token, minted by staging-vault-init>
HILT_VAULT_UNSEAL_KEY=<vault unseal key, minted by staging-vault-init>
