# Ingot configuration template for the smelt compose stack.
#
# `smelt generate` renders one copy per gateway declared in smelt.yml into
# generated/ingot/<name>.yaml, which compose mounts read-only at
# /etc/ingot/config.yaml. Env overrides use the INGOT_ prefix (e.g.
# INGOT_LOG_LEVEL). Everything that differs between gateways is a field
# below: the region, the identity, the database, the hilt that authorizes
# the gateway and the vault holding the region KEK.

# S3 listener — bind 0.0.0.0 so other containers / the host port can reach it.
# Port 80 inside the compose network: {{.DID}} resolves to
# http://{{.Name}}:80/.well-known/did.json (the stack's did:web convention).
addr: "0.0.0.0:80"
# The region this gateway serves. Compose always passes INGOT_REGION, which
# wins over this value.
region: {{.Region}}
data_dir: /data
log_level: info

# Local blob budget in bytes; 0 is none. INGOT_LOCAL_BLOB_MAX_BYTES, passed
# through in compose.yml, sets it. The key is here too because ingot builds
# before fil-forge/ingot#228 apply an INGOT_* variable only to a key they
# already know.
local_blob_max_bytes: 0

# Agent identity: the signer of every invocation this gateway issues (to
# hilt, sprue, piri), wrapped as {{.DID}}. The key is generated by `make
# generate` into generated/keys/{{.Name}}.pem and mounted read-only; the
# gateway serves the matching DID document at /.well-known/did.json so the
# peers can resolve the did:web to it. The hilt → ingot proof and hilt's
# provider registration both name {{.DID}}.
identity:
  key_file: /keys/ingot.pem
  service_id: {{.DID}}

# Registry / segment metadata.
postgres_dsn: "postgres://ingot:ingot@ingot-postgres:5432/{{.Database}}?sslmode=disable"

# Forge upload service (sprue) — control plane for /blob/add etc.
upload_service_url: "http://upload:80"
upload_service_did: "did:web:upload"
upload_receipts_url: "http://upload:80/receipt"

# Indexing service — read-path locator (digest -> location commitment).
indexer_endpoint: "http://indexer:80"
indexer_did: "did:web:indexer"

# S3 authorization service: the hilt holding this region's tenants.
auth_service_url: "http://{{.Hilt}}:80"
auth_service_did: "{{.HiltDID}}"
# hilt → ingot delegations for /s3/request/authorize and /s3/bucket/*
auth_service_proofs: "/proofs/{{.S3ProofTxt}}"

# UCAN revocation service (swarf) — ingot subscribes to its revocation
# firehose so hilt's access-key deletions clear the per-key authorization
# caches. Set both or neither.
revocation_service_url: "http://swarf:80"
revocation_service_did: "did:web:swarf"

# Per-plane shipping is configurable; defaults ship both planes. To keep
# the MST catalog local-only (provider-regional, never shipped), the
# daemon honours per-plane ship flags — see ingot's Config.

# Region CEK wrap (regional security RFC): the wrap runs inside
# ingot-openbao's transit engine, so the region KEK never enters ingot. The
# token comes from INGOT_REGIONKEY_OPENBAO_TOKEN in compose.yml. Ingot builds
# that predate the openbao provider (fil-forge/ingot#105) ignore this block.
regionkey:
  provider: openbao
  openbao:
    address: "http://{{.Vault}}:8200"
    mount: transit
    key: region-kek

# Browser origins allowed to call this gateway directly. The Fil One console
# served by `pnpm --filter @filone/website dev` is one: it fetches presigned
# URLs from the browser, which a gateway refuses from an unlisted origin. Every
# gateway needs it, because a console account reaches all of them.
cors_allowed_origins:
  - https://localhost:5173

# Tenant wrap key (FEE tenant recipient): ingot resolves the tenant's did:plc
# document from the PLC directory and encrypts every stored object to the
# X25519 key hilt publishes at the tenant's #wrap verification method. Writes
# fail without it. Ingot builds that predate the tenant recipient ignore
# this block.
tenantkey:
  plc_directory_url: "http://plc:3000"
